acelet"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: He gave me a charm."}, {"type": "audio", "content": "engenn5le06ob06aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Turkish"}, {"type": "definition", "content": "relating to the country of Turkey "}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: He gave me an old Turkish charm."}, {"type": "audio", "content": "engenn5le06ob06aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Cut a piece of paper into 8 square pieces."}, {"type": "text", "content": "Write an adjective on each piece of paper."}, {"type": "text", "content": "Choose different adjectives (opinion, size, color, age, material, origin)."}, {"type": "text", "content": "Mix the cards up and choose four."}, {"type": "text", "content": "Use the adjectives to describe a person or thing."}, {"type": "text", "content": "Remember to put the adjectives in the correct order before the noun."}, {"type": "text", "content": "Read the sentences aloud to your partner. "}, {"type": "text", "content": "Your partner will check the word order."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write describing words on paper."}, {"type": "text", "content": "I choose four words and describe a person or thing."}, {"type": "text", "content": "I read my sentence to my partner."}]}], "labs": [{"stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le06ob06re2aud01", "coverimg": "engenn5le06ob06re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le06ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: So, did you meet any other strange people?<br>\n<span class=\"strong\">Sally