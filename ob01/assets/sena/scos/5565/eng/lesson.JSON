{"_data": [{"contents": [{"content": "Vanessa Makes a New Friend", "type": "lesson_name"}, {"content": "I Want to Find Someone Who ... ", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Talking About the Future", "type": "heading"}, {"content": " You use the Future tense (<span class=\"strong\">will</span>) to talk about actions in the future. You can also use the modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> to talk about possible actions in the future.", "type": "describer"}, {"content": "The auxiliary <span class=\"strong\">will </span>goes before the verb. The short form is \u2018ll.", "type": "text"}, {"content": "You use the Future tense when you talk about the future, make offers or make predictions.", "type": "text"}, {"content": "The modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> go before the verb. ", "type": "text"}, {"content": "They talk about future possibility or chance that something will happen. ", "type": "text"}, {"content": "<span class=\"strong\">Might </span>means there is a smaller chance that something will happen (30%).", "type": "text"}, {"content": "<span class=\"strong\">May</span> means there is a slightly greater chance that something will happen (50%).", "type": "text"}, {"content": "I'll decide in the morning.", "type": "example"}, {"content": "I might go shopping.", "type": "example"}, {"content": "I may go shopping, too. I'm free.<br/> <br/>", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Agreeing and Disagreeing Tactfully", "type": "heading"}, {"content": "You use different phrases to agree and disagree tactfully (politely). <br> Look at the chart below.", "type": "describer"}, {"content": "{\"rows\":9,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Agreeing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Disagreeing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I agree with you 100 percent.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't think so.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I couldn't agree with you more.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm afraid I disagree.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That's so true.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm afraid I don't agree.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You're absolutely right.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Not necessarily.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Absolutely.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That's not always true.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That's exactly how I feel.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"No, I'm not so sure about that.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Exactly.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I see what you're saying, but ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You have a point there.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't know about that ...\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "mysterious", "type": "name"}, {"content": "difficult to understand or know", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I like my men mysterious and quiet.", "type": "example"}, {"content": "engenn5le06ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to describe people.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "shy", "type": "name"}, {"content": "being quiet and reserved around other people", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He is shy and quiet.", "type": "example"}, {"content": "engenn5le06ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "honest", "type": "name"}, {"content": "truthful; sincere", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I like it when people are honest about what they want.", "type": "example"}, {"content": "engenn5le06ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "forward", "type": "name"}, {"content": "not afraid to say what you are thinking", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The men here are a little too forward.", "type": "example"}, {"content": "engenn5le06ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "hot", "type": "name"}, {"content": "casual language to describe a good-looking person", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The men here are so hot!", "type": "example"}, {"content": "engenn5le06ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "direct ", "type": "name"}, {"content": "straight to the point", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I like it when people are direct and honest.", "type": "example"}, {"content": "engenn5le06ob01aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn5le06ob01re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Make a list of 5 adjectives to describe someone's personality.", "type": "text"}, {"content": "Ask different people if those words describe them.<br/> For example: <span class=\"italic\">Are you honest? Tell me more.</span>", "type": "text"}, {"content": "Write the person's name next to the adjective.", "type": "text"}, {"content": "Compare your results with other classmates.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I describe people with a variety of words.", "type": "text"}, {"content": "I talk with different people about their personalities.", "type": "text"}, {"content": "I compare the results with others in my class.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn5le06ob01re2aud01", "images": [{"image": "engenn5le06ob01re2img01.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn5le06ob01re2img01.jpg", "id": 1, "time": "100", "text": "<span class=\"strong\">Sally</span>: Hey, Vanessa! How are things with you? <br>\n<span class=\"strong\">Vanessa</span>: Hi, Sally. Things are good. Work is really busy. What's up with you?<br>\n<span class=\"strong\">Sally</span>: I'm traveling around the Middle East at the moment. The men here are so hot!<br>\n<span class=\"strong\">Vanessa</span>: Tell me more!<br>"}, {"image": "engenn5le06ob01re2img07.jpg", "id": 2, "time": "16500", "text": "<span class=\"strong\">Sally</span>: They're all dark and handsome. Just my type! They are a little too forward, though.<br>\n<span class=\"strong\">Vanessa</span>: Oh, I like it when men are  direct and honest about what they want. <br>\n<span class=\"strong\">Sally</span>: I don't know about that ... a little mystery is exciting, too. I like my men mysterious and a little shy. <br>\n<span class=\"strong\">Vanessa</span> : I see what you're saying but I prefer to know how they feel and what they're thinking!<br>"}, {"image": "engenn5le06ob01re2img02.jpg", "id": 3, "time": "40000", "text": "<span class=\"strong\">Sally</span>: To each their own, I suppose. What will you do tomorrow?<br>\n<span class=\"strong\">Vanessa</span>: I might go shopping ... I'll decide in the morning. You?<br>\n<span class=\"strong\">Sally</span>: I may do some shopping, too. I'd like to get some souvenirs. <br>"}], "coverimg": "engenn5le06ob01re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn5le06ob01re6aud04", "images": [], "coverimg": ""}, "type": "picture"}], "template_override": 1, "_data": [], "type": "audio", "id": 2}, {"title": "", "contents": [{"value": "engenn5le06ob01re6aud04", "type": "audio"}], "template_override": 1, "_data": [], "type": "text", "id": 3}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": "I can agree and disagree tactfully.", "type": "Learning Outcomes"}, {"content": "I can describe people's personality.", "type": "Learning Outcomes"}, {"content": "I can talk about things, actions and events in the future.", "type": "Learning Outcomes"}, {"content": "What kind of person are you? Describe yourself in three words.", "type": "Free Header Item"}, {"content": "What qualities do you look for in a boyfriend/girlfriend?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct", "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "To each their own ... I suppose.", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"id": 1, "stimuli_ids": [1], "template_override": 1, "_data": [{"contents": [{"content": "Sally and Vanessa chat about men. What is Sally's <span class=\"tool-tip\" id=\"tip_1_0\"> type</span>?", "type": "text"}], "type": "instructions"}, {"contents"