"content": "engenn5le06ob08re4img03.jpg", "type": "image"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "Have I told you how __________ he is too?", "type": "text"}, {"content": "engenn5le06ob08re4aud02", "type": "audio"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 1, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "engenn5le06ob08re4img04.jpg", "type": "image"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "I was a little", "type": "text"}, {"content": "engenn5le06ob08re4aud03", "type": "audio"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 2, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "engenn5le06ob08re4img01.jpg", "type": "image"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "He was _________ with the injured bird.", "type": "text"}, {"content": "engenn5le06ob08re4aud04", "type": "audio"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 3, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "engenn5le06ob08re4img02.jpg", "type": "image"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "What an", "type": "text"}, {"content": "engenn5le06ob08re4aud05", "type": "audio"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "engenn5le06ob08re4img05.jpg", "type": "image"}], "selected": 0}]}], "type": "TTT", "id": 3, "stimuli_ids": []}, {"template_override": 1, "_data": [{"contents": [{"content": "<span class=\"strong\">Look at the descriptive paragraph. Imagine you went on a date like Vanessa. You want to e-mail a friend to tell them what happened.</span>", "type": "text"}, {"content": "<span class=\"italic\"><br/>Instructions: <br/><span class=\"bullet\">Write a 75-100 word e-mail to a friend.</span> <br/> <span class=\"bullet\">Describe a date you went on. Where did you go?</span> <br/> <span class=\"bullet\">Use sentences that include the Past Continuous tense and the Simple Past tense.</span> <br/> <span class=\"bullet\">Include a description of your date. What did he or she look like?</span><br/>\n\n\n<span class=\"bullet\">When you have completed your paragraph, Click the <span class=\"strong\">Go To Writing Task</span> button.  </span></span>", "type": "text"}, {"content": "</br></br><span class=\"strong\">My paragraph</span>", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 3", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "You are done!", "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "When writing an e-mail, remember to include: </br> <ul> <li>A subject line</li> <li>A greeting and a closing</li> <li>A description of where you went on the date</li> <li>A description of your date (hair, face, personality)</li> <li>Sentences using the Past Continuous tense and the Simple Past tense</li></ul>", "type": "text"}, {"content": "Proofread your e-mail.</br></br> Read your e-mail aloud to a partner or family member.</br></br> Click the <span class=\"strong\">Submit</span> button to save your work.", "type": "text"}], "type": "instructions"}, {"grading_contents": {"header": {"rows": [{"cells": [{"element": "th", "con