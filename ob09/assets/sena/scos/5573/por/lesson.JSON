{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa Makes a New Friend"}, {"type": "unit_name", "content": "TTYL (Talk to You Later)"}, {"type": "position", "content": 9}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 6}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe characteristics of different people and their jobs."}, {"type": "secondary_1", "content": "Placeholder"}, {"type": "secondary_2", "content": "Placeholder"}, {"type": "secondary_3", "content": ""}, {"type": "secondary_4", "content": ""}, {"type": "secondary_5", "content": ""}, {"type": "secondary_6", "content": ""}, {"type": "secondary_7", "content": ""}, {"type": "secondary_8", "content": ""}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Past Continuous Tense"}, {"type": "describer", "content": " You use the Past Continuous tense to talk about something that was happening at a particular time in the past."}, {"type": "text", "content": "You often use the Past Continuous tense together with the Simple Past tense. <br>The Past Continuous talks about a longer \u2018background' action. The Simple Past talks about a shorter event that happened in the middle of, or interrupted, the longer event."}, {"type": "text", "content": " You use the words <span class=\"strong\">when</span> and <span class=\"strong\">while</span> before the longer action."}, {"type": "example", "content": "While we were hiking, I was able to forget about work."}, {"type": "example", "content": "When I was talking on the phone, the doorbell rang."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to relax"}, {"type": "definition", "content": "to become less tense"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Hiking relaxes me."}, {"type": "audio", "content": "engenn5le06ob09aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about activities."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "invigorating"}, {"type": "definition", "content": "energizing; refreshing"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Spending time outdoors is invigorating."}, {"type": "audio", "content": "engenn5le06ob09aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to hang out"}, {"type": "definition", "content": "to spend time with someone"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I'm hanging out with Marco."}, {"type": "audio", "content": "engenn5le06ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to interrupt"}, {"type": "definition", "content": "to stop an activity "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'm not interrupting, am I?"}, {"type": "audio", "content": "engenn5le06ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "doorbell "}, {"type": "definition", "content": "the button you press at someone's front door to get their attention"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I heard the doorbell. Is someone here?"}, {"type": "audio", "content": "engenn5le06ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to ring"}, {"type": "definition", "content": "to make a sound with a bell"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Ring the doorbell when you get to my house."}, {"type": "audio", "content": "engenn5le06ob09aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be off "}, {"type": "definition", "content": "to have time off from w