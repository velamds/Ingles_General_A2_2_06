\\\": \\\"Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tall <bR> old\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tallest <br>oldest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Most adjectives:  <br>+ -est\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"late<br> nice\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"latest <br>nicest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjectives ending in -e:  <br>+-st\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happy<br> lucky\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happiest <br>luckiest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2-syllable adjectives ending in -y: <br> +iest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"attractive <br>intelligent <br>beautiful\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"most attractive <br>most intelligent <br>most beautiful\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3+-syllable adjectives:  <br>most + adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"good <br> bad\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the best <br>the worst\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Irregular comparisons\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "text", "content": "You add <span class=\"strong\">the</span> in front of the superlative form to describe people, places and things."}, {"type": "example", "content": "He is <span class=\"underline\">the most attractive</span> man in the city."}, {"type": "example", "content": "I am <span class=\"underline\">the luckiest</span> woman."}, {"type": "example", "content": "He is <span class=\"underline\">the cutest</span> boy in the world."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Reacting to a Story"}, {"type": "describer", "content": "When someone tells you a story, it is important to react to show that you are listening and that you are interested."}, {"type": "text", "content": "When someone tells you a story, it is important to react to show that you are listening and that you are interested."}, {"type": "text", "content": "Oh, really? <br>Wow! <br>That's interesting! <br>Tell me more! <br>I can't believe that! <br>What do you mean?"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "strange "}, {"type": "definition", "content": "odd; unusual"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Everyone I meet is really strange!"}, {"type": "audio", "content": "engenn5le06ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to describe someone."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "wild"}, {"type": "definition", "content": "crazy; not normal"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She was acting wild."}, {"type": "audio", "content": "engenn5le06ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "rude"}, {"type": "definition", "content": "impolite"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She was very rude."}, {"type": "audio", "content": "engenn5le06ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "lanky"}, {"type": "definition", "content": "having long, thin arms and legs"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She was lanky."}, {"type": "audio", "content": "engenn5le06ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "tattooed"}, {"type": "definition", "content": "having many tattoos"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She was tattooed."}, {"type": "audio", "content": "engenn5le06ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "unkept"}, {"type": "definition", "content": "messy; not neat"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She was very unkept."}, {"type": "audio", "content": "engenn5le06ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "outfit"}, {"type": "definition", "content": "the clothes that someone is wearing"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She had the strangest outfit on."}, {"type": "audio", "content": "engenn5le06ob05aud07"}]}, {"type": "background_image", "content": "engenn5le06ob05re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Get an old magazine and cut out parts of pictures of people (a head, arms, legs etc.)."}, {"type": "text", "content": "Stick them together to create a new person."}, {"type": "text", "content": "Describe your \u201cnew\u201d person to your partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I create a \u201cnew\u201d person with images."}, {"type": "text", "content": "I describe my \u201cnew\u201d person to my partner."}]}]}